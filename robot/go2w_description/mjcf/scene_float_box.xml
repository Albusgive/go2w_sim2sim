<mujoco model="go2w scene">

  <include file="go2w.xml" />
  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
    <mesh name="flag" vertex="0 0 0  0.6 0 0  0 0 0.3 0 0.01 0 0 -0.01 0" />
  </asset>

  <default>
    <default class="collision_">
      <geom solimp="0.1 0.9 0.001 0.5 2" solref="-100 -20" condim="6" solmix="1" />
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    <geom name="floor2" size="100 100 0.05" type="box" pos="0 0 -0.051" material="groundplane" />

    <body pos="0 -3 0" name="red_flaag" mocap="true">
      <site pos="0 0 0.5" type="cylinder" size="0.01 0.5" rgba="1 1 1 1" />
      <geom pos="0 0 0.7" type="mesh" mesh="flag" rgba="1 0 0 1" />
    </body>

    <replicate count="5" offset="0 2 0">
      <geom pos="3 -2.5 0.7" type="box" size="1 1 0.3" class="collision_" />
    </replicate>

    <replicate count="3" offset="1.5 0 0.05">
      <replicate count="5" offset="0 2 0">
        <geom pos="5 -2.5 0" type="box" size="0.05 1 0.05" class="collision_" />
      </replicate>
    </replicate>

    <replicate count="5" offset="0 2 0">
      <geom pos="12 -2.5 0.65" type="box" size="1 1 0.3" class="collision_" />
    </replicate>

    <replicate count="9" offset="0 1.5 -0.02">
      <geom pos="0 2 0.55" type="box" size="1 0.5 0.1" rgba=".9 .9 .9 .5" class="collision_" />
      <geom pos="1.05 2 0" type="box" size="0.05 .5 .5" rgba=".9 .9 .9 .5" class="collision_" />
      <geom pos="-1.05 2 0" type="box" size="0.05 .5 .5" rgba=".9 .9 .9 .5" class="collision_" />
    </replicate>


  </worldbody>

</mujoco>