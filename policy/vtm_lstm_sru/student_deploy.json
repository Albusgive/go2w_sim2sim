{
    "schema": "student_teacher_sru_split_v1",
    "model_name": "student",
    "original_full_models": {
        "jit": "student.pt",
        "onnx": "student.onnx"
    },
    "input": {
        "name": "obs",
        "total_length": 629,
        "segments": [
            {
                "group": "policy_normal",
                "type": "1D",
                "range": [
                    0,
                    53
                ],
                "shape": [
                    53
                ]
            },
            {
                "group": "policy_image",
                "type": "2D",
                "range": [
                    53,
                    629
                ],
                "shape": [
                    1,
                    18,
                    32
                ]
            }
        ]
    },
    "intermediate_tensors": {
        "encoded_obs_dim": 117,
        "latent_dim": 256
    },
    "memory": {
        "type": "lstm_sru",
        "num_layers": 1,
        "hidden_dim": 256
    },
    "pipelines": {
        "jit": {
            "state_management": "internal_memory_module",
            "equivalent_call_sequence": [
                {
                    "module": "student_encoder.pt",
                    "inputs": [
                        "obs"
                    ],
                    "outputs": [
                        "encoded_obs"
                    ]
                },
                {
                    "module": "student_memory.pt",
                    "inputs": [
                        "encoded_obs"
                    ],
                    "outputs": [
                        "latent"
                    ],
                    "reset_methods": [
                        "reset",
                        "reset_done"
                    ]
                },
                {
                    "module": "student_actor.pt",
                    "inputs": [
                        "latent"
                    ],
                    "outputs": [
                        "actions"
                    ]
                }
            ]
        },
        "onnx": {
            "state_management": "external_hidden_cell",
            "equivalent_call_sequence": [
                {
                    "module": "student_encoder.onnx",
                    "inputs": [
                        "obs"
                    ],
                    "outputs": [
                        "encoded_obs"
                    ]
                },
                {
                    "module": "student_memory.onnx",
                    "inputs": [
                        "encoded_obs",
                        "hidden_state",
                        "cell_state"
                    ],
                    "outputs": [
                        "latent",
                        "next_hidden_state",
                        "next_cell_state"
                    ]
                },
                {
                    "module": "student_actor.onnx",
                    "inputs": [
                        "latent"
                    ],
                    "outputs": [
                        "actions"
                    ]
                }
            ]
        }
    }
}